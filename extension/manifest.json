{
  "manifest_version": 3,
  "name": "BOTFAKE LITE — Wave 200 local tab test",
  "version": "200.13.0",
  "description": "Bản test clone Wave 200.13: tab Pancake điều phối và thực thi pipeline gửi",
  "permissions": [
    "tabs",
    "storage",
    "scripting",
    "cookies",
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "https://pages.fm/*",
    "https://pancake.vn/*",
    "https://pancake.ph/*",
    "https://pancake.id/*",
    "https://pancake.in/*",
    "https://pancake.biz/*",
    "https://socialos.vip/*",
    "https://*/*",
    "http://*/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "BOTFAKE LITE",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://pancake.vn/*",
        "https://*.pancake.vn/*",
        "https://pages.fm/*",
        "https://*.pages.fm/*",
        "https://pancake.ph/*",
        "https://pancake.id/*",
        "https://pancake.in/*",
        "https://pancake.biz/*",
        "https://socialos.vip/*"
      ],
      "js": [
        "pancake-send-lite-wave200.user.js"
      ],
      "run_at": "document_start",
      "all_frames": false,
      "world": "MAIN"
    },
    {
      "matches": [
        "https://pancake.vn/*",
        "https://*.pancake.vn/*",
        "https://pages.fm/*",
        "https://*.pages.fm/*",
        "https://pancake.ph/*",
        "https://pancake.id/*",
        "https://pancake.in/*",
        "https://pancake.biz/*",
        "https://socialos.vip/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "https://*/*",
        "http://*/*"
      ],
      "js": [
        "overlay.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
