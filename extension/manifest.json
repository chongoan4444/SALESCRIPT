{
  "manifest_version": 3,
  "name": "BOTFAKE LITE",
  "version": "1.91.5",
  "description": "Gửi hàng loạt Pancake trong background + overlay Pancake #1/#2 khi đổi tab",
  "permissions": ["tabs", "storage", "scripting"],
  "host_permissions": [
    "https://pages.fm/*",
    "https://pancake.vn/*",
    "https://pancake.ph/*",
    "https://pancake.id/*",
    "https://pancake.in/*",
    "https://pancake.biz/*",
    "https://socialos.vip/*",
    "https://*/*",
    "http://*/*"
  ],
  "action": {
    "default_title": "BOTFAKE LITE",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://*/*", "http://*/*"],
      "js": ["pancake-send-lite.user.js"],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": ["https://*/*", "http://*/*"],
      "js": ["overlay.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
