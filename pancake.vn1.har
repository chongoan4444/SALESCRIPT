a(0, 0, 0, 0);\\n  }\\n  40% {\\n    color: rgb(136, 136, 136);\\n    text-shadow: 0.25em 0 0 rgba(0, 0, 0, 0), 0.5em 0 0 rgba(0, 0, 0, 0);\\n  }\\n  60% {\\n    text-shadow: 0.25em 0 0 rgba(0, 0, 0, 0.65), 0.5em 0 0 rgba(0, 0, 0, 0);\\n  }\\n  80%,\\n  100% {\\n    text-shadow: 0.25em 0 0 rgba(0, 0, 0, 0.65), 0.5em 0 0 rgba(0, 0, 0, 0.65);\\n  }\\n}\\n\\n@keyframes calling-green{\\n\\n  0% {\\n      transform: scale(1);\\n  }\\n  15% {\\n      box-shadow: 0 0 0 2px rgba(82, 196, 26, 0.25);\\n  }\\n  25% {\\n      box-shadow: 0 0 0 4px rgba(82, 196, 26, 0.5), 0 0 0 8px rgba(82, 196, 26, 0.25);\\n  }\\n  25% {\\n      box-shadow: 0 0 0 8px rgba(82, 196, 26, 0.5), 0 0 0 16px rgba(82, 196, 26, 0.25);\\n  }\\n}\\n\\n@keyframes calling-red{\\n\\n  0% {\\n      transform: scale(1);\\n  }\\n  15% {\\n      box-shadow: 0 0 0 3px rgba(255, 77, 79, 0.25);\\n  }\\n  25% {\\n      box-shadow: 0 0 0 4px rgba(255, 77, 79, 0.5), 0 0 0 8px rgba(255, 77, 79, 0.25);\\n  }\\n  25% {\\n      box-shadow: 0 0 0 8px rgba(255, 77, 79, 0.5), 0 0 0 16px rgba(255, 77, 79, 0.25);\\n  }\\n}\\n\\n.btn-filter-page {\\n  display: flex;\\n  align-items: center;\\n  padding: 5px 36px;\\n  padding-right: 0;\\n  border: none;\\n  background: #eaecf0 !important;\\n  border-radius: 6px;\\n  box-shadow: none !important;\\n  width: 128px;\\n  min-width: 128px;\\n\\n  .suffix-icon { \\n    position: absolute;\\n    right: 4px;\\n    height: 100%;\\n    display: flex;\\n    align-items: center;\\n    .close-icon {\\n      fill: #98A2B3;\\n    }\\n  }\\n  \\n  .filter-icon {\\n    position: absolute;\\n    left: 8px;\\n    display: flex;\\n    align-items: center;\\n    height: 100%;\\n  }\\n\\n  &:has(.suffix-icon) {\\n    padding-right: 28px;\\n  }\\n\\n  .count-filter-page-container {\\n    display: flex;\\n    align-items: center;\\n\\n    .page-filter-avatar {\\n      border-radius: 50%;\\n      border: 1px solid #fff;\\n      margin-left: -8px;\\n    }\\n\\n    .extra-count-page {\\n      width: 22px;\\n      height: 22px;\\n      margin-left: -8px;\\n\\n      border-radius: 50%;\\n      border: 1px solid #FFF;\\n      background: #BAE0FF;\\n      color: #105CE2;\\n      font-size: 12px;\\n      font-weight: 400;\\n      line-height: 16px;\\n    }\\n  }\\n\\n  &:hover {\\n    background: #dde1e7 !important;\\n  }\\n\\n  .text-filter {\\n    color: #667085;\\n    line-height: 22px;\\n  }\\n}\\n\\n.facebook-calling-centered {\\n  display: flex;\\n  justify-content: center;\\n  align-items: center;\\n}\\n\\n.facebook-navbar {\\n  display: flex;\\n  align-items: center;\\n  cursor: pointer;\\n  padding: 1px 12px 1px 8px;\\n\\n  .calling-description-hover {\\n    display: none;\\n  }\\n\\n  &:hover {\\n    background: rgba(29, 41, 57, 0.25);\\n    border-radius: 8px;\\n\\n    .calling-description {\\n      display: none;\\n    }\\n\\n    .calling-description-hover {\\n      display: block;\\n    }\\n  }\\n\\n  .calling-avatar-container {\\n    position: relative;\\n    padding-right: 12px;\\n\\n    .calling-avatar-animation {\\n      position: absolute;\\n      width: 36px;\\n      height: 36px;\\n      border-radius: 100%;\\n      top: 0;\\n      left: 0;\\n      right: 0;\\n      animation: play 2s ease infinite;\\n    }\\n\\n    .calling-avatar-wrapper {\\n      border: 1px solid;\\n      border-color: #52C41A;\\n      background: transparent;\\n      padding: 1px;\\n      border-radius: 100%;\\n      width: 36px;\\n      height: 36px;\\n\\n      .nav-call-avatar {\\n        border-radius: 50%;\\n      }\\n\\n      .multi-call-avatar {\\n        border-radius: 20px;\\n        background: #52C41A;\\n        height: 32px;\\n        width: 32px;\\n      }\\n  \\n    }\\n\\n    .calling-avatar-icon {\\n      position: absolute;\\n      width: 22px;\\n      height: 18px;\\n      border-radius: 12px;\\n      bottom: 0;\\n      right: 4px;\\n    }\\n  }\\n\\n  .calling-info-container {\\n    .calling-info-title {\\n      max-width: 120px;\\n      white-space: nowrap;\\n      overflow: hidden;\\n      color: #FFF;\\n      text-overflow: ellipsis;\\n      font-weight: 500;\\n      line-height: 22px;\\n    }\\n\\n    .calling-info-subtitle {\\n      font-size: 12px;\\n      line-height: 16px;\\n      color: #FFF;\\n    }\\n  }\\n}\\n\\n.app-navbar > li > a.sip-calling-wrapper {\\n  height: 40px;\\n  margin-right: 8px;\\n  border-radius: 20px;\\n}\\n\\n.ui-color {\\n  .sip-missed-count {\\n    .possip-app-bar-icon {\\n      color: white;\\n      background-color: rgba(29, 41, 57, 0.25);\\n\\n      &:hover {\\n        color: white;\\n        background-color: rgba(29, 41, 57, 0.2);\\n      }\\n    }\\n  }\\n}\\n\\n.ui-light {\\n  .calling-info-container {\\n    .calling-info-title {\\n      color: #1D2939;\\n    }\\n\\n    .calling-info-subtitle {\\n      color: #667085;\\n    }\\n  }\\n\\n  .sip-missed-count {\\n    .possip-app-bar-icon {\\n      color: #344054;\\n      background-color: #f2f4f7;\\n\\n      &:hover {\\n        color: #344054;\\n        background-color: rgb(234, 236, 240);\\n      }\\n    }\\n  }\\n}\\n\\n#call-setting-line {\\n  margin: 0px -16px 12px;\\n  border-top: 1px solid #D9D9D9;  \\n}\\n\\n.audio-setting {\\n  .anticon {\\n    width: 16px;\\n    height: 16px;\\n    margin-right: 6px;\\n  }\\n  \\n  .ant-select-dropdown-menu-item svg {\\n    display: none;\\n  }\\n}\\n\\n.mic-permission-modal {\\n  .ant-modal-content {\\n    width: fit-content;\\n    padding: 24px;\\n    border-radius: 16px;\\n\\n    .no-mic-permission-container {\\n      display: flex;\\n      flex-direction: column;\\n      gap: 24px;\\n      font-family: 'Roboto';\\n\\n      .no-mic-content {\\n        display: flex;\\n        flex-direction: column;\\n        gap: 4px;\\n\\n        .no-mic-title {\\n          color: #101828;\\n          font-size: 16px;\\n          font-weight: 500;\\n          line-height: 24px;\\n        }\\n\\n        .no-mic-subtitle {\\n          color: #667085;\\n          line-height: 22px;\\n        }\\n      }\\n    }\\n\\n    .ant-modal-confirm-btns {\\n      margin-top: 24px;\\n      \\n      .understand-button {\\n        display: inline-block;\\n        padding: 1px 8px;\\n        border-radius: 6px;\\n        background: #D2EBFF;\\n        cursor: pointer;\\n        color: #105CE2;\\n        font-size: 14px;\\n        font-weight: 500;\\n        line-height: 22px;\\n\\n        &:hover {\\n          background: #d6e1ed;\\n        }\\n      }\\n    }\\n  }\\n}\\n.call-settings-container {\\n  display: flex;\\n  align-items: center;\\n  justify-content: space-between;\\n\\n  .setting-icons {\\n    display: flex;\\n    justify-content: center;\\n    align-items: center;\\n    width: 32px;\\n    height: 32px;\\n    border-radius: 8px;\\n    cursor: pointer;\\n\\n    &:hover {\\n      background-color: #ECEDF4;\\n    }\\n\\n    svg {\\n      width: 24px;\\n      height: 24px;\\n    }\\n\\n    &.disabled {\\n      opacity: 0.5;\\n      cursor: not-allowed;\\n    }\\n  }\\n}\\n\\n.caller-log-tooltip {\\n  .ant-tooltip-content {\\n    .ant-tooltip-inner {\\n      padding: 12px;\\n      border-radius: 8px;\\n      color: #D0D5DD;\\n\\n      .caller-log-type {\\n        margin-bottom: 4px;\\n        font-weight: 500;\\n        color: #FFF;\\n      }\\n    }\\n  }\\n}\\n\\n.calls-minimize-and-close-container {\\n  display: flex;\\n  align-items: center;\\n  justify-content: space-between;\\n  gap: 4px;\\n}\\n\\n.call-log-list-tags-conv {\\n  float: left;\\n  width: 100%;\\n  display: flex;\\n  flex-wrap: wrap;\\n  gap: 6px;\\n\\n  .ant-tag {\\n    height: 20px;\\n    margin: 0px;\\n    padding: 2px 8px;\\n    display: flex;\\n    align-items: center;\\n    gap: 4px;\\n    font-size: 12px;\\n    border-radius: 12px;\\n    border-radius: 16px;\\n    border: none;\\n    box-shadow: none;\\n    font-family: 'Roboto';\\n\\n    &.call-log-tags-hide {\\n      padding: 2px 6px;\\n      display: flex;\\n      align-items: center;\\n      justify-content: center;\\n      border-radius: 16px;\\n      font-weight: 500;\\n      color: #344054;\\n      background: #EAECF0;\\n      border: 1px solid #D0D5DD;\\n    }\\n  }\\n\\n  .call-log-remove-tag-icon {\\n    fill: #667085;\\n    cursor: pointer;\\n  \\n    &:hover {\\n      fill: #1D2939;\\n    }\\n  }\\n}\\n\\n.call-log-popover-tags {\\n  .ant-popover-inner {\\n    display: flex;\\n  }\\n}\\n\\n.sip-container .ant-modal, .facebook-calling-wrapper {\\n  z-index: 900;\\n\\n  .current-log-item {\\n    display: flex;\\n    justify-content: space-between;\\n    padding: 5px 0;\\n    align-items: center;\\n  }\\n\\n  .ant-divider {\\n    margin: 0;\\n    color: rgba(0, 0, 0, 0.65);\\n    font-size: 14px;\\n  }\\n\\n  #filter-title {\\n    width: 32px;\\n    height: 32px;\\n    position: relative;\\n\\n    #filter-icon {\\n      padding: 6px;\\n      border-radius: 8px;\\n      cursor: pointer;\\n      color: #344054;\\n      background-color: #EAECF0;\\n\\n      &:hover {\\n        background-color: #dde1e7;\\n      }\\n    }\\n\\n    #clear-filter {\\n      position: absolute;\\n      top: -4px;\\n      right: -4px;\\n      cursor: pointer;\\n    }\\n  }\\n\\n  .ant-modal-content {\\n    padding: 0;\\n    border: 0 !important;\\n    height: 580px;\\n    width: 880px !important;\\n    background: #D9DBEA;\\n    box-shadow: 0px 3px 6px -4px rgba(0, 0, 0, 0.12), 0px 6px 16px rgba(0, 0, 0, 0.08), 0px 9px 28px 8px rgba(0, 0, 0, 0.05);\\n    border-radius: 16px;\\n    overflow: hidden;\\n\\n    .ant-modal-close-x {\\n      display: flex;\\n      align-items: center;\\n      margin: 0px 10px !important;\\n    }\\n  }\\n\\n  .ant-modal-body {\\n    padding: 0;\\n    display: flex;\\n    flex-direction: column;\\n\\n    .sip-header {\\n      height: 56px;\\n      display: flex;\\n      align-items: center;\\n      background: white;\\n      font-weight: 500;\\n      font-size: 16px;\\n      padding-left: 24px;\\n      border-radius: 4px 4px 0px 0px;\\n    }\\n\\n    .sip-body {\\n      display: flex;\\n      height: 580px;\\n\\n      .sip-call-logs, .sip-customer-call-detail-info {\\n        flex: 1;\\n        display: flex;\\n        flex-direction: column;\\n        background: white;\\n      }\\n\\n      .sip-call-logs {\\n        .ant-menu {\\n          font-size: 16px;\\n          padding-left: 4px;\\n\\n          .ant-menu-item {\\n            padding-inline: 16px;\\n          }\\n\\n          .ant-menu-title-content {\\n            height: 57px;\\n            display: inline-flex;\\n            align-items: center;\\n            font-family: 'Roboto';\\n          }\\n\\n          .ant-menu-item-selected {\\n            color: #1677FF;\\n            border-bottom-color: #1677FF;\\n\\n            &:after {\\n              inset-inline: 16px;\\n              border-bottom-color: #1677ff;\\n              transition: border-color 0.3s cubic-bezier(0.645, 0.045, 0.355, 1);\\n            }\\n          }\\n\\n          .ant-menu-item:not(.ant-menu-item-selected):not(.ant-menu-submenu-selected):hover {\\n            color: #1677FF;\\n\\n            &::after {\\n              border-bottom-color: transparent;\\n            }\\n          }\\n        }\\n\\n        .empty-call-logs {\\n          height: 400px;\\n          display: flex;\\n          flex-direction: column;\\n          justify-content: center;\\n          align-items: center;\\n          color: #667085;\\n\\n          .empty-call-logs_main-text {\\n            padding: 16px 0 4px;\\n            font-size: 16px;\\n            font-weight: 500;\\n            color: #475467;\\n          }\\n        }\\n  \\n        .log-title {\\n          display: flex;\\n          justify-content: space-between;\\n          align-items: center;\\n          height: 49px;\\n          padding: 12px 20px;\\n          font-size: 16px;\\n          color: rgba(0, 0, 0, 0.85);\\n\\n          #phone-filter {\\n            flex: 1;\\n            margin-right: 8px;\\n\\n            .ant-input-affix-wrapper {\\n              border: 1px solid transparent;\\n              border-radius: 6px;\\n              background-color: #EAECF0;\\n\\n              &:hover {\\n                background-color: #DDE1E7;\\n              }\\n            }\\n\\n            .ant-input-affix-wrapper-focused {\\n              background-color: white !important;\\n              border: 1px solid #4096FF;\\n            }\\n\\n            .ant-input {\\n              &::placeholder {\\n                color: #667085;\\n              }\\n            }\\n          }\\n        }\\n\\n        .call-tips-container {\\n          width: 418px;\\n          height: 64px;\\n          position: fixed;\\n          margin: 0px 8px;\\n          z-index: 1;\\n          background: white;\\n\\n          .call-tips {\\n            display: flex;\\n            align-items: center;\\n            margin-top: 8px;\\n            background: #F0F5FF;\\n            border-radius: 4px;\\n  \\n            svg {\\n              width: 16px;\\n              height: 16px;\\n              margin: 16px 8px;\\n            }\\n  \\n            .call-tips-text {\\n              flex: 1;\\n              line-height: 20px;\\n              font-size: 13px;\\n              color: rgba(0, 0, 0, 0.85);\\n            }\\n          }\\n        }\\n  \\n        .call-logs-container {\\n          overflow-anchor: none;\\n          flex: 1;\\n          padding-bottom: 12px;\\n  \\n          .ant-divider {\\n            color: rgba(0, 0, 0, 0.65);\\n            font-size: 14px;\\n            margin: 0;\\n            margin-top: 10px;\\n          }\\n\\n          /* Hide scrollbar for Chrome, Safari and Opera */\\n          &::-webkit-scrollbar {\\n            display: none;\\n          }\\n\\n          /* Hide scrollbar for IE, Edge and Firefox */\\n          -ms-overflow-style: none;  /* IE and Edge */\\n          scrollbar-width: none;  /* Firefox */\\n        }\\n\\n        .sticky-header {\\n          padding-top: 56px;\\n        }\\n  \\n        .call-log {\\n          height: 76px;\\n          display: flex;\\n          align-items: center;\\n          margin: 0 20px;\\n          padding: 12px;\\n          border-radius: 8px;\\n          position: relative;\\n          cursor: pointer;\\n\\n          .call-log_avatar {\\n            position: relative;\\n            display: flex;\\n            align-items: center;\\n            margin-right: 12px;\\n\\n            .log-type, .log-missed-calls-count {\\n              display: flex;\\n              justify-content: center;\\n              position: absolute;\\n              right: -4px;\\n              bottom: -4px;\\n              border-radius: 50%;\\n              background-color: white;\\n            }\\n\\n            .log-type {\\n              padding: 2px 3px;\\n              font-size: 18px;\\n            }\\n\\n            .log-missed-calls-count {\\n              width: 24px;\\n              padding: 0 4px;\\n              font-weight: 500;\\n            }\\n          }\\n\\n          .call-log_customer-info {\\n            flex: 1;\\n            display: flex;\\n            flex-direction: column;\\n\\n            .call-log_phone-number-and-time {\\n              margin-bottom: 4px;\\n              display: flex;\\n              align-items: center;\\n              justify-content: space-between;\\n\\n              .call-log_phone-number {\\n                padding: 1px 8px;\\n                border-radius: 6px;\\n\\n                &:hover {\\n                  background-color: #DDE1E7;\\n                }\\n              }\\n\\n              .call-log_phone-number-and-dtmf {\\n                display: flex;\\n                align-items: center;\\n                min-width: 0;\\n\\n                .call-log_dtmf {\\n                  margin-left: 4px;\\n                  color: #667085;\\n                  font-size: 12px;\\n                  white-space: nowrap;\\n                }\\n              }\\n\\n              .call-log_customer-call-time {\\n                flex-shrink: 0;\\n                font-size: 12px;\\n                color: #475467;\\n              }\\n            }\\n\\n            .call-log_customer-avatar-call-info-and-more-detail {\\n              height: 24px;\\n              margin-left: 8px;\\n              display: flex;\\n              align-items: center;;\\n              color: #DDE1E7;\\n\\n              .horizontal-separate-line {\\n                width: 1px;\\n                height: 12px;\\n                margin: 0 4px;\\n                background: #D0D5DD;\\n              }\\n\\n              .call-log_btn {\\n                font-size: 18px;\\n                margin-left: auto;\\n                color: #98A2B3;\\n                visibility: hidden;\\n              }\\n            }\\n          }\\n\\n          .audio-container {\\n            color: #667085;\\n\\n            .audio-container-list-item {\\n              display: flex;\\n              align-items: center;\\n              gap: 4px;\\n\\n              .copy-link-recording-file, .download-recording-file, .play-icon {\\n                display: flex;\\n                padding: 3px;\\n                cursor: pointer;\\n                color: #344054;\\n                border-radius: 6px;\\n    \\n                &:hover {\\n                  background: #DDE1E7;\\n                }\\n              }\\n\\n              .detail-audio-info {\\n                display: none;\\n              }\\n\\n              .audio-slider {\\n                .ant-slider {\\n                  width: 88px;\\n                  margin: 0;\\n\\n                  .ant-slider-rail,\\n                  .ant-slider-track,\\n                  .ant-slider-step {\\n                    height: 5px\\n                  }\\n\\n                  .ant-slider-rail {\\n                    border-radius: 8px;\\n                    background-color: #EAECF0;\\n                  }\\n\\n                  .ant-slider-track {\\n                    border-radius: 99px;\\n                    background-color: #98A2B3;\\n                  }\\n\\n                  .ant-slider-handle {\\n                    display: none;\\n                  }\\n                }\\n\\n              }\\n            }\\n          }\\n\\n          &:hover {\\n            // Đang xem c\\xf3 n\\xean để background kh\\xf4ng\\n            // background-color: #F2F4F7;\\n\\n            // .log-type, .log-missed-calls-count {\\n            //   background-color: #F2F4F7;\\n            // }\\n\\n            .audio-container-list-item {\\n              .detail-audio-info {\\n                display: flex;\\n              }\\n            }\\n\\n            .call-log_customer-info .call-log_btn {\\n              visibility: visible;\\n            }\\n          }\\n        }\\n\\n        .call-log_separate-line {\\n          margin: 0 32px;\\n          border-top: 1px solid #EAECF0;\\n        }\\n\\n        // call log cuối sẽ kh\\xf4ng c\\xf3 separate-line\\n        .call-log_separate-line:has(+ :not(.call-log)) {\\n          display: none;\\n        }\\n      }\\n\\n      .sip-customer-call-detail-info {\\n        .sip-customer-call-detail-info_header-text {\\n          display: flex;\\n          align-items: center;\\n          padding: 16px 20px;\\n          font-size: 16px;\\n          font-weight: 500;\\n          color: #1D2939;\\n          border-bottom: 1px solid #EAECF0;\\n\\n          .back-to-call-log-btn {\\n            padding: 6px;\\n            margin-right: 10px;\\n            color: #344054;\\n            border-radius: 6px;\\n            cursor: pointer;\\n\\n            &:hover {\\n              background-color: #DDE1E7;\\n            }\\n          }\\n        }\\n\\n        .sip-customer-call-detail-info_container {\\n          display: flex;\\n          flex-direction: column;\\n          height: 515px;\\n          flex: 1;\\n          padding: 24px 40px;\\n          gap: 32px;\\n          font-family: 'Roboto';\\n\\n          .call-log-list-tags-conv {\\n            margin-top: 12px;\\n          }\\n\\n          .customer-call-extra-info_container {\\n            display: flex;\\n            flex-direction: column;\\n            gap: 8px;\\n\\n            .customer-call-extra-info_general-info-text {\\n              font-size: 12px;\\n              line-height: 16px;\\n              font-weight: 500;\\n              color: #667085;\\n            }\\n\\n            .customer-call-extra-info_item {\\n              padding: 0 4px;\\n              display: flex;\\n              align-items: center;\\n              justify-content: space-between;\\n\\n              .customer-call-extra-info_left-content {\\n                display: flex;\\n                align-items: center;\\n                gap: 9px;\\n                color: #667085;\\n\\n                svg {\\n                  width: 18px;\\n                  height: 18px;\\n                }\\n              }\\n\\n              .customer-call-extra-info_right-content {\\n                color: #1D2939;\\n              }\\n            }\\n          }\\n\\n          .sip-customer-call-detail-info_call-history {\\n            overflow-y: auto;\\n            color: #667085;\\n\\n            .sip-customer-call-detail-info_recent-call-txt {\\n              font-size: 12px;\\n              font-weight: 500;\\n              line-height: 16px;\\n              margin-bottom: 8px;\\n            }\\n\\n            .current-log-list {\\n              .current-log-item {\\n                height: 30px;\\n                padding: 4px;\\n                margin-bottom: 4px;\\n                line-height: 22px;\\n                border-radius: 8px;\\n                display: flex;\\n                align-items: center;\\n                justify-content: space-between;\\n          \\n                .user-avatar {\\n                  margin-left: 8px;\\n                }\\n\\n                &:hover {\\n                  background: #EAECF0;\\n                }\\n              }\\n\\n              .current-log-time {\\n                display: flex;\\n                align-items: center;\\n                color: #1D2939;\\n          \\n                .log-type {\\n                  display: flex;\\n                  font-size: 16px;\\n                  margin-right: 6px;\\n                }\\n              }\\n\\n              .current-log-user {\\n                display: flex;\\n              }\\n            }\\n\\n            /* Hide scrollbar for Chrome, Safari and Opera */\\n            &::-webkit-scrollbar {\\n              display: none;\\n            }\\n\\n            /* Hide scrollbar for IE, Edge and Firefox */\\n            -ms-overflow-style: none;  /* IE and Edge */\\n            scrollbar-width: none;  /* Firefox */\\n          }\\n        }\\n      }\\n\\n      .sip-call-note {\\n        position: absolute;\\n        inset: 0;\\n        z-index: 13;\\n        display: flex;\\n        flex-direction: column;\\n        background: linear-gradient(180deg, rgba(29, 41, 57, 0.55) 0%, rgba(29, 41, 57, 0.45) 51.22%, rgba(29, 41, 57, 0.55) 100%);\\n        backdrop-filter: blur(100px);\\n        border-radius: 0 4px 4px 0;\\n\\n        .sip-call-note_header-text {\\n          display: flex;\\n          align-items: center;\\n          padding: 16px 20px;\\n          font-size: 16px;\\n          font-weight: 500;\\n          color: white;\\n\\n          .back-to-call-log-btn {\\n            padding: 6px;\\n            margin-right: 10px;\\n            color: white;\\n            border-radius: 6px;\\n            cursor: pointer;\\n\\n            &:hover {\\n              background-color: rgba(255, 255, 255, 0.16);\\n            }\\n          }\\n        }\\n\\n        .sip-call-note_container {\\n          display: flex;\\n          flex-direction: column;\\n          flex: 1;\\n          padding: 24px;\\n          gap: 16px;\\n          font-family: 'Roboto';\\n\\n          .sip-call-note_field {\\n            display: flex;\\n            flex-direction: column;\\n            gap: 6px;\\n\\n            .sip-call-note_label {\\n              font-size: 12px;\\n              line-height: 16px;\\n              font-weight: 500;\\n              color: rgba(255, 255, 255, 0.85);\\n            }\\n          }\\n\\n          .sip-call-note_field-content {\\n            flex: 1;\\n            min-height: 0;\\n\\n            .ant-input {\\n              flex: 1;\\n              resize: none;\\n            }\\n          }\\n        }\\n      }\\n\\n      .sip-session {\\n        backdrop-filter: blur(100px);\\n\\n        .phone-input-wrapper {\\n          margin-bottom: 16px;\\n          width: 58%;\\n\\n          .ant-select-single {\\n            height: 56px;\\n          }\\n        }\\n  \\n        .typed-phone {\\n          height: 56px;\\n          padding: 8px;\\n          display: flex;\\n          justify-content: center;\\n          gap: 8px;\\n          border: none;\\n          background: transparent;\\n\\n          &.disabled::placeholder {\\n            color: #98A2B3 !important;\\n          }\\n        }\\n\\n        .phone-input-wrapper .typed-phone input.ant-input {\\n          text-align: center;\\n          font-size: 30px;\\n\\n          &::placeholder {\\n            font-size: 14px;\\n            color: #667085;\\n            // center align placeholder\\n            transform: translate3d(0, -4px, 0)\\n          }\\n\\n          &:focus::placeholder {\\n            color: transparent;\\n          }\\n        }\\n\\n        // do CSS của b\\xean CRM đang important\\n        .phone-input-wrapper .ant-select-selector {\\n          border: none !important;\\n          box-shadow: none !important;\\n        }\\n  \\n        .back-btn {\\n          width: 118px;\\n          color: rgba(0, 0, 0, 0.85);\\n          font-size: 14px;\\n          margin-right: 16px;\\n          cursor: pointer;\\n\\n          i {\\n            padding-right: 7px;\\n          }\\n        }\\n\\n        .call-action-container {\\n          width: 70px;\\n          display: inline-flex;\\n          flex-direction: column;\\n          align-items: center;\\n          color: black;\\n\\n          .ant-btn.call-action {\\n            padding: 0px;\\n            border-radius: 50% !important;\\n            width: 52px;\\n            height: 52px;\\n            font-size: 20px;\\n            margin-bottom: 8px;\\n            color: rgba(0, 0, 0, 0.65);\\n            border: 1px solid #D9D9D9;\\n            transform: scaleX(-1);\\n            \\n            .anticon {\\n              height: 32px;\\n              font-size: 32px;\\n              display: flex;\\n              justify-content: center;\\n            }\\n\\n            &:hover {\\n              color: #6399F2;\\n              border: 1px solid #6399F2;\\n            }\\n          }\\n\\n          .disable-call-action {\\n            color: white !important;\\n            background: linear-gradient(0deg, rgba(0, 0, 0, 0.65), rgba(0, 0, 0, 0.65)), #FFFFFF;\\n          }\\n        }\\n  \\n        .backspace-btn {\\n          cursor: pointer;\\n          width: 18px;\\n          height: 20px;\\n          border-radius: 0 4px 4px 0;\\n          background: #D9DBEA;\\n          color: rgba(0, 0, 0, 0.85);\\n          position: relative;\\n\\n          &:before {\\n            background: transparent;\\n            border-bottom: 10px solid transparent;\\n            border-right: 10px solid #D9DBEA;\\n            border-top: 10px solid transparent;\\n            content: '';\\n            position: absolute;\\n            left: -10px;\\n            top: 0;\\n          }\\n  \\n          &:hover {\\n            background: #bfbfbf;\\n  \\n            &:before {\\n              border-right: 10px solid #bfbfbf;\\n            }\\n          }\\n        }\\n  \\n        .number-btn {\\n          margin-bottom: 16px;\\n          padding: 12px 16px;\\n          font-size: 30px;\\n          cursor: pointer;\\n          background: #DDE1E7;\\n          display: flex;\\n          height: 64px;\\n          width: 64px;\\n          border-radius: 20px;\\n          justify-content: center;\\n          align-items: center;\\n          color: #1D2939;\\n          user-select: none;\\n  \\n          &:hover {\\n            background-color: #EAECF0;\\n          }\\n        }\\n\\n        .disabled-number-btn {\\n          color: #FFF;\\n          background-color: #D0D5DD;\\n          pointer-events: none;\\n        }\\n  \\n        .sip-info {\\n          flex: 1;\\n          justify-content: space-between;\\n          padding: 40px;\\n          align-items: center;\\n          overflow: auto;\\n  \\n          .sip-call-info {\\n            height: 210px;\\n\\n            .info-content {\\n              margin: 0px 0px 32px 0px;\\n              display: inline-flex;\\n              width: 100%;\\n              justify-content: space-between;\\n            }\\n\\n            .call-session-status {\\n              display: flex;\\n              flex-direction: column;\\n              align-items: center;\\n              line-height: 24px;\\n              font-size: 16px;\\n            }\\n\\n            .select-customer-conversations {\\n              float: right;\\n              cursor: pointer;\\n            }\\n  \\n            .select-customer-conversations:hover {\\n              color: #40a9ff;\\n            }\\n          }\\n        }\\n      }\\n    }\\n  }\\n}\\n\\n.sip-container {\\n  .ant-modal-body {\\n    background: white;\\n\\n    &:has(.calling-container) {\\n      background: linear-gradient(180deg, rgba(29, 41, 57, 0.55) 0%, rgba(29, 41, 57, 0.45) 51.22%, rgba(29, 41, 57, 0.55) 100%);\\n    }\\n  }\\n}\\n\\n.facebook-calling-wrapper {\\n  .ant-modal-content {\\n    background: #FFF;\\n    box-shadow: 0px 3px 6px -4px rgba(0, 0, 0, 0.12), 0px 6px 16px 0px rgba(0, 0, 0, 0.08), 0px 9px 28px 8px rgba(0, 0, 0, 0.05);\\n\\n    .ant-modal-body {\\n      height: 100%;\\n    }\\n  }\\n\\n  .facebook-calling-container {\\n    display: flex;\\n    height: 100%;\\n    .list-call-incoming-container {\\n      flex: 1;\\n      display: flex;\\n      flex-direction: column;\\n\\n      .list-call-incoming-header {\\n        padding: 20px 20px 16px 20px;\\n        border-bottom: 1px solid #EAECF0;\\n        &-title {\\n          color: #1D2939;\\n          font-size: 16px;\\n          font-weight: 500;\\n          line-height: 24px;\\n          margin-bottom: 8px;\\n        }\\n        &-action {\\n          display: flex;\\n          gap: 8px;\\n        }\\n      }\\n\\n      .incoming-calls-container {\\n        flex: 1 0 0;\\n        min-height: 0;\\n\\n        .waiting-for-call-container {\\n          padding: 0;\\n        }\\n\\n        .virtual-scroll-area {\\n          height: 100%;\\n          max-height: unset;\\n        }\\n\\n        .virtual-scroll-list {\\n          height: 100%;\\n          overflow: auto;\\n          padding: 0px 20px 20px 20px;\\n        }\\n\\n\\n        .incoming-call-item {\\n          padding: 16px 0px;\\n          display: flex;\\n          gap: 12px;\\n          border-bottom: 1px solid #F2F4F7;\\n          &:last-child {\\n            border-bottom: 0px;\\n          }\\n          .item-avatar-container {\\n            position: relative;\\n\\n            .item-avatar {\\n              border-radius: 100%;\\n              width: 44px;\\n              height: 44px;\\n            }\\n\\n            .page-avatar {\\n              border: 1px solid #FFF;\\n              border-radius: 100%;\\n              position: absolute;\\n              width: 24px;\\n              height: 24px;\\n              bottom: 0;\\n              right: -6px;\\n            }\\n          }\\n          \\n          .call-from-info-container {\\n            display: flex;\\n            flex-direction: column;\\n            flex-grow: 1;\\n            overflow: hidden;\\n            white-space: nowrap;\\n            text-overflow: ellipsis;\\n            max-width: 240px;\\n            \\n\\n            .call-from-name {\\n              color: #1D2939;\\n              font-size: 16px;\\n              font-weight: 400;\\n              line-height: 24px;\\n              text-overflow: ellipsis;\\n              overflow: hidden;\\n            }\\n\\n            .call-from-page {\\n              color: #667085;\\n              max-width: 100%;\\n              white-space: nowrap;\\n              text-overflow: ellipsis;\\n              overflow: hidden;\\n              line-height: 22px;\\n            }\\n          }\\n\\n          .call-action {\\n            display: flex;\\n            gap: 8px;\\n\\n            .call-action-button-container {\\n              width: 40px;\\n              height: 40px;\\n              display: flex;\\n              align-items: center;\\n              justify-content: center;\\n              border-radius: 8px;\\n              cursor: pointer;\\n            }\\n\\n            .accept-button {\\n              background-color: #D2EBFF;\\n              color: #105CE2;\\n\\n              &:hover {\\n                background-color: #D6E1ED;\\n              }\\n            }\\n\\n            .cancel-button {\\n              background-color: #FEE4E2;\\n              color: #CF1322;\\n\\n              &:hover {\\n                background-color: #FECDCA;\\n              }\\n            }\\n\\n            .disable-button {\\n              background-color: #F9FAFB;\\n              color: #98A2B3;\\n              cursor: not-allowed;\\n\\n              &:hover {\\n                background-color: #F9FAFB;\\n              }\\n            }\\n          }\\n        }\\n      }\\n    }\\n\\n    .waiting-for-call-container {\\n      padding: 60px 20px 44px 20px;\\n      display: flex;\\n      align-items: center;\\n      justify-content: center;\\n      flex-direction: column;\\n      height: 100%;\\n      img {\\n        width: 160px;\\n        height: 160px;\\n        margin-bottom: 16px;\\n      }\\n\\n      .wait-call-title {\\n        color: #475467;\\n        text-align: center;\\n        font-size: 16px;\\n        font-style: normal;\\n        font-weight: 500;\\n        line-height: 24px;\\n      }\\n\\n      .wait-call-subtitle {\\n        margin-top: 8px;\\n        color: #667085;\\n        text-align: center;\\n        line-height: 22px;\\n      }\\n    }\\n\\n    .main-call-container {\\n      flex: 1;\\n      position: relative;\\n      background-color: #F9FAFB;\\n    }\\n  }\\n}\\n\\n.main-call-header {\\n  display: flex;\\n  justify-content: space-between;\\n  align-items: center;\\n  width: 100%;\\n  user-select: none;\\n\\n  // D\\xf9ng để lấy nền background đằng sau theo ava, className n\\xe0y sẽ nằm tr\\xean m\\xe0 kh\\xf4ng chiếm div\\n  z-index: 12;\\n  position: absolute;\\n}\\n\\n.sip-container .sip-session,\\n.facebook-calling-wrapper .main-call-container {\\n  flex: 1;\\n  position: relative;\\n  background-color: #F9FAFB;\\n\\n  .main-call-header {\\n    padding: 20px 20px 8px;\\n  }\\n\\n  .calling-container {\\n    .calling-to {\\n      justify-content: center; \\n    }\\n  }\\n\\n  .main-calling-action {\\n    padding: 20px;\\n    gap: 12px;\\n  }\\n\\n  .sub-calling-action {\\n    bottom: 120px;\\n    gap: 8px;\\n\\n    .calling-button {\\n      padding: 9px;\\n      border-radius: 12px;\\n    }\\n  }\\n}\\n\\n.main-calling-action,\\n.sub-calling-action {\\n  position: absolute;\\n  width: 100%;\\n  display: flex;\\n  justify-content: center;\\n  align-items: center;\\n\\n  .calling-button {\\n    display: flex;\\n    align-items: center;\\n    justify-content: center;\\n    cursor: pointer;\\n    background: rgba(0, 0, 0, 0.20);\\n    color: white;\\n\\n    &:hover {\\n      background: #0000004D;\\n    }\\n  }\\n\\n  .calling-button-active {\\n    background: #fff;\\n    color: #344054;\\n\\n    &:hover {\\n      background: #F2F4F7;\\n    }\\n  }\\n}\\n\\n.main-calling-action {\\n  bottom: 0;\\n\\n  .hang-up-button {\\n    width: 64px;\\n    height: 48px;\\n    display: flex;\\n    align-items: center;\\n    justify-content: center;\\n    border-radius: 16px;\\n    background: #FF4D4F;\\n    color: white;\\n    cursor: pointer;\\n\\n    &:hover {\\n      background: #F5222D;\\n    }\\n  }\\n\\n  .calling-button {\\n    padding: 12px;\\n    border-radius: 16px;\\n  }\\n}\\n\\n.calling-minimized-container {\\n  width: 360px;\\n  border-radius: 16px;\\n  cursor: initial;\\n  overflow: hidden;\\n  position: relative;\\n  z-index: 1;\\n  box-shadow: 0px 4px 24px 4px rgba(0, 0, 0, 0.24);\\n\\n  .draggable-icon {\\n    position: absolute;\\n    top: 0;\\n    left: 178px;\\n    z-index: inherit;\\n  }\\n\\n  .main-call-header {\\n    padding: 12px 16px;\\n    color: #FFF;\\n    font-size: 16px;\\n  }\\n\\n  .calling-container-blur {\\n    padding: 72px 16px 88px;\\n\\n    .calling-from-info {\\n      padding: 0px;\\n\\n      .calling-item-avatar {\\n        margin: 0px;\\n      }\\n\\n      .calling-minimize_order-and-tag {\\n        display: flex;\\n        margin-top: 4px;\\n        gap: 12px;\\n\\n        .calling-minimize_order, .calling-minimize_tag {\\n          display: flex;\\n          align-items: center;\\n          gap: 4px;\\n        }\\n      }\\n    }\\n  }\\n\\n  .main-calling-action {\\n    padding: 12px 16px;\\n    gap: 8px;\\n  }\\n\\n  &:hover {\\n    cursor: all-scroll;\\n  }\\n}\\n\\n.calling-container {\\n  background: rgba(0, 0, 0, 0.25);\\n  height: 100%;\\n  position: relative;\\n\\n  .calling-container-background {\\n    // cho trường hợp kh\\xf4ng c\\xf3 avatar\\n    display: flex;\\n    align-items: center;\\n\\n    width: 100%;\\n    height: 100%;\\n    position: absolute;\\n    .calling-img-background {\\n      border-radius: 0 13px 13px 0 !important;\\n    }\\n  }\\n}\\n\\n.calling-container-blur {\\n  height: 100%;\\n  background: linear-gradient(180deg, rgba(29, 41, 57, 0.55) 0%, rgba(29, 41, 57, 0.45) 51.22%, rgba(29, 41, 57, 0.55) 100%);\\n  backdrop-filter: blur(100px);\\n  padding-top: 60px;\\n  \\n  display: flex;\\n  flex-direction: column;\\n  align-items: center;\\n\\n  .calling-from-info {\\n    width: 100%;\\n    padding: 40px 20px;\\n    display: flex;\\n    align-items: center;\\n    flex-grow: 1;\\n    color: white;\\n\\n    .calling-item-avatar {\\n      position: relative;\\n      margin-bottom: 32px;\\n      .from-avatar {\\n        border: 1px solid #FFF;\\n        border-radius: 100%;\\n      }\\n\\n      .page-avatar {\\n        border: 1px solid #FFF;\\n        border-radius: 100%;\\n        position: absolute;\\n        bottom: 0;\\n        right: 0\\n      }\\n    }\\n\\n    .calling-from-name {\\n      margin-bottom: 4px;\\n    }\\n\\n    .calling-to {\\n      display: flex;\\n      align-items: center;\\n\\n      .phone-number-info {\\n        padding: 2px;\\n        margin-left: 4px;\\n        border-radius: 6px;\\n        cursor: pointer;\\n\\n        &:hover {\\n          background: rgba(0, 0, 0, 0.30);\\n        }\\n      } \\n    }\\n\\n    .bold-text {\\n      font-size: 20px;\\n      font-weight: 500;\\n      line-height: 28px;\\n    }\\n\\n    .normal-text {\\n      line-height: 22px;\\n      font-weight: 400;\\n    }\\n\\n    .calling-footer {\\n      margin-top: 32px;\\n      display: flex;\\n      flex-direction: column;\\n      align-items: center;\\n\\n      .calling-sip-phone-number {\\n        display: flex;\\n        align-items: center;\\n        margin-bottom: 4px;\\n        font-size: 12px;\\n        line-height: 16px;\\n      }\\n    }\\n\\n    .conv-tags-container {\\n      height: 20px;\\n    }\\n\\n    .calling-time {\\n      color: #FFF;\\n      font-size: 16px;\\n      line-height: 24px;\\n      text-align: center;\\n    }\\n  }\\n}\\n\\n.main-call-header {\\n  .text-button, .action-button {\\n    width: 32px;\\n    height: 32px;\\n    display: flex;\\n    align-items: center;\\n    justify-content: center;\\n    border-radius: 8px;\\n    cursor: pointer;\\n    color: #344054;\\n  \\n    &:hover {\\n      background-color: #DDE1E7;\\n    }\\n  }\\n  \\n  .action-button {\\n    color: #FFF;\\n  \\n    &:hover {\\n      background-color: #0000004D !important;\\n    }\\n  }\\n}\\n\\n.customer-call-info-container {\\n  .customer-call-info {\\n    width: 100%;\\n    border: none;\\n    padding: 0;\\n    img {\\n      box-shadow: 0px 2px 6px 0px hsla(0, 0%, 100%, 0.2);\\n    }\\n    display: flex;\\n    align-items: center;\\n  \\n    .customer-called-info {\\n      flex: 1;\\n      overflow: hidden;\\n      white-space: nowrap;\\n      text-overflow: ellipsis;\\n    }\\n  \\n    .phone-call {\\n      color: #105CE2;\\n      background-color: #D2EBFF;\\n  \\n      &:hover {\\n        background-color: #D6E1ED;\\n      }\\n    }\\n  \\n    .phone-call-disabled {\\n      color: #98A2B3;\\n      background-color: #F9FAFB;\\n    }\\n  \\n    .phone-call, .phone-call-disabled {\\n      width: 40px;\\n      height: 40px;\\n      padding: 8px;\\n      border-radius: 8px;\\n    }\\n  \\n    .customer-info-name {\\n      margin-left: 8px;\\n      font-size: 14px;\\n      font-weight: 500;\\n      line-height: 22px;\\n      color: #667085;\\n      white-space: nowrap;\\n      overflow: hidden;\\n      text-overflow: ellipsis;\\n    }\\n    .customer-info-phone-number {\\n      display: flex;\\n      align-items: center;\\n      font-weight: 400;\\n      font-size: 20px;\\n      line-height: 28px;\\n\\n      .phone-number {\\n        padding: 1px 8px;\\n        border-radius: 6px;\\n        cursor: pointer;\\n\\n        &:hover {\\n          background-color: #DDE1E7;\\n        }\\n      }\\n    }\\n    .list_tags_conv_customer-sip {\\n      display: inline-flex;\\n      height: 20px;\\n      font-size: 12px;\\n    }\\n  }\\n}\\n\\n\\n.sip-missed-count {\\n  .possip-app-bar-icon {\\n    display: flex;\\n    align-items: center;\\n    padding: 10px;\\n    position: relative;\\n    border-radius: 50%;\\n    color: #D0D5DD;\\n    background-color: #344054;\\n\\n    .status-online{\\n      position: absolute;\\n      top: 6px;\\n      right: 10px;\\n      width: 6px;\\n      height: 6px;\\n      border-radius: 32px;\\n      background: #73D13D;\\n    }\\n\\n    &:hover {\\n      color: #EAECF0;\\n      background: #475467;\\n    }\\n  }\\n  .ant-badge-count {\\n    top: 8px !important;\\n    right: unset;\\n    left: -12px !important;\\n    padding: 0px 2px;\\n    line-height: 16px;\\n    min-width: 16px;\\n    height: 16px;\\n    box-shadow: none;\\n    padding-left: 1.5px;\\n  }\\n}\\n\\n@media screen and (max-width: 1440px){\\n  .sip-missed-count {\\n    .ant-badge-count {\\n      padding-left: 2px;\\n    }\\n  }\\n}\\n\\n// Pancake sip UI\\n.sip-nav-item {\\n  .sip-calling-wrapper {\\n    &:has(.sip-nav_phone-ring), &:has(.sip-nav_phone-call-away) {\\n      border-radius: 8px;\\n    }\\n  }\\n}\\n\\n// pancake sip navbar\\n.sip-container-session {\\n  display: flex;\\n  align-items: center;\\n  margin: 0px 12px 0px 8px;\\n\\n  .phone-info {\\n    margin-left: 12px;\\n    .number {\\n      height: 20px;\\n      line-height: 20px;\\n    }\\n    .status {\\n      height: 12px;\\n      font-size: 12px;\\n      line-height: 12px;\\n      font-style: italic;\\n    }\\n  }\\n\\n  .sip-nav_phone-call-away:hover + .phone-info {\\n    .status::before {\\n      content: \\\"End call\\\";\\n    }\\n\\n    .status div {\\n      display: none;\\n    }\\n  }\\n\\n}\\n\\n// crm sip navbar\\n.sip-container-session_crm {\\n  width: 36px;\\n  height: 36px;\\n  padding: 8px;\\n  border-radius: 20px;\\n  cursor: pointer;\\n\\n  &:hover {\\n    background-color: #FFF;\\n\\n    svg {\\n      fill: #1677ff;\\n    }\\n  }\\n\\n  .sip-missed-count {\\n    .ant-badge-dot {\\n      top: 2px;\\n      right: 3px;\\n      width: 10px;\\n      height: 10px;\\n      min-width: 10px;\\n    }\\n  }\\n\\n}\\n\\n// pos sip navbar\\n.sip-container-session_pos {\\n  margin-left: 16px;\\n}\\n\\n// ffm sip navbar\\n.sip-container-session_ffm {\\n  margin-right: 16px;\\n  line-height: 0px;\\n}\\n\\n// do b\\xean POS css ngo\\xe0i n\\xean cần important\\n.sip-container-session_pos-dropdown,\\n.sip-container-session_ffm-dropdown {\\n  .ant-dropdown-menu {\\n    padding: 4px !important;\\n\\n    .ant-dropdown-menu-item {\\n      border-radius: 4px !important;\\n    }\\n  }\\n}\\n\\n.quick-alo-ph-circle {\\n  width: 56px;\\n  height: 56px;\\n  top: 50px;\\n  left: 50px;\\n  border: 2px solid #73D13D;\\n  background-color: transparent;\\n  border-radius: 100%;\\n  opacity: 0.1;\\n  animation: quick-alo-circle-anim 1.2s infinite ease-in-out;\\n  transition: all 0.5s;\\n  transform-origin: 50% 50%;\\n}\\n\\n.quick-alo-ph-circle-fill {\\n  position: absolute;\\n  width: 56px;\\n  height: 56px;\\n  top: 0px;\\n  left: 0px;\\n  background-color: rgba(0, 161, 255, 0.5);\\n  border-radius: 100%;\\n  border: 2px solid transparent;\\n  opacity: 0.1;\\n  animation: quick-alo-circle-fill-anim 2.3s infinite ease-in-out;\\n  transition: all 0.5s;\\n  transform-origin: 50% 50%;\\n}\\n\\n.quick-alo-ph-img-circle {\\n  background-size: 20px 20px !important;\\n  position: absolute;\\n  width: 33px;\\n  height: 33px;\\n  top: 11px;\\n  left: 11px;\\n  background: #73D13D\\n  url('data:image/png;base64,')\\n    no-repeat center center;\\n  border-radius: 16px;\\n  border: 2px solid transparent;\\n  opacity: 0.99;\\n  animation: quick-alo-circle-img-anim 1s infinite ease-in-out;\\n  transform-origin: 50% 50%;\\n\\n  &:hover {\\n    background-color: #52C41A;\\n  }\\n}\\n\\n.sip-nav_phone-ring, .sip-nav_phone-call-away {\\n  position: relative;\\n  display: flex;\\n  align-items: center;\\n  width: 32px;\\n  height: 32px;\\n  padding: 4px;\\n  border-radius: 20px;\\n  justify-content: center;\\n  color: white;\\n  background: #53c31b;\\n}\\n\\n// phone ring\\n.sip-nav_phone-ring {\\n  animation: 2s ease 0s infinite normal none running calling-green;\\n}\\n\\n.phone-call,\\n.phone-call-disabled,\\n.phone-reject,\\n.phone-reject-disabled,\\n.phone-answer,\\n.phone-answer-disabled {\\n  cursor: pointer;\\n  width: 64px;\\n  height: 48px;\\n  position: relative;\\n  display: inline-block;\\n\\n  .quick-alo-ph-circle,\\n  .quick-alo-ph-circle-fill {\\n    width: 79px;\\n    height: 63px;\\n    top: -7px;\\n    left: -7px;\\n    position: absolute;\\n  }\\n\\n  .quick-alo-ph-img-circle {\\n    top: 0;\\n    left: 0;\\n    background-size: 30px 30px !important;\\n    width: 64px;\\n    height: 48px;\\n  }\\n}\\n\\n.filter-page-dropdown {\\n  height: 218px;\\n  border-radius: 8px;\\n  background: #FFF;\\n  box-shadow: 0px 6px 14px -6px rgba(24, 39, 75, 0.12), 0px 10px 32px -4px rgba(24, 39, 75, 0.10);\\n  .list-page-filter {\\n    padding: 6px;\\n    overflow: auto;\\n    max-height: 218px;\\n    display: flex;\\n    flex-direction: column;\\n    gap: 4px;\\n\\n    .page-item-filter {\\n      padding: 5px 12px;\\n      border-radius: 6px;\\n      display: flex;\\n      gap: 8px;\\n      cursor: pointer;\\n      align-items: center;\\n\\n      &:hover {\\n        background: #E2F2FF;\\n      }\\n\\n      .page-filter-avatar {\\n        border-radius: 50%;\\n      }\\n\\n      .page-filter-name {\\n        overflow: hidden;\\n        color: #1D2939;\\n        text-overflow: ellipsis;\\n        white-space: nowrap;\\n        font-size: 14px;\\n        max-width: 189px;\\n        line-height: 22px; /* 157.143% */ /* 157.143% */\\n      }\\n    }\\n\\n    .filter-selected {\\n      background: #D2EBFF;\\n      .page-filter-name {\\n        font-weight: 500;\\n      }\\n      &:hover {\\n        background: #D2EBFF;\\n\\n      }\\n    }\\n  }\\n}\\n\\n.phone-call,\\n.phone-call-disabled,\\n.phone-reject,\\n.phone-reject-disabled {\\n  padding: 12px 20px;\\n  border-radius: 16px;\\n}\\n\\n.phone-call-disabled, .phone-reject-disabled, .phone-answer-disabled, .incomming-call-disabled {\\n  pointer-events: none;\\n  color: #8496b4;\\n  background-color: #ECEDF4;\\n  animation: none;\\n}\\n\\n.phone-reject {\\n  color: white;\\n  background: #FF4D4F;\\n\\n  &:hover {\\n    background-color: #F5222D;\\n  }\\n}\\n\\n.phone-call {\\n  color: white;\\n  background: #73D13D;\\n\\n  &:hover {\\n    background-color: #52C41A;\\n  }\\n}\\n\\n.loader {\\n  width: 20px;\\n  height: 20px;\\n  border: 2px solid #FFF;\\n  border-bottom-color: #69B1FF;\\n  border-radius: 50%;\\n  display: inline-block;\\n  box-sizing: border-box;\\n  animation: rotation 1s linear infinite;\\n  }\\n\\n  @keyframes rotation {\\n  0% {\\n      transform: rotate(0deg);\\n  }\\n  100% {\\n      transform: rotate(360deg);\\n  }\\n} \\n\\n.call-setting-source-popover {\\n  // đoạn n\\xe0y cần important do b\\xean POS đang css thẳng v\\xe0o antd ở view overview\\n  .ant-popover-inner {\\n    padding: 0 16px !important;\\n    border-radius: 12px;\\n\\n    .ant-popover-inner-content {\\n      padding: 0px !important;\\n    }\\n    //\\n  }\\n\\n  .setting-in-out-source {\\n    width: 357px;\\n\\n    .call-setting-title {\\n      padding: 6px 0;\\n      color: #1D2939;\\n      font-size: 16px;\\n      font-style: normal;\\n      font-weight: 500;\\n      line-height: 24px;\\n    }\\n\\n    #call-setting-line {\\n      border-top: 1px solid #EAECF0;  \\n      margin-bottom: 0;\\n    }\\n\\n    &-content {\\n      display: flex;\\n      flex-direction: column;\\n      padding: 12px 0;\\n      gap: 12px;\\n\\n      .item-title {\\n        color: #475467;\\n        font-size: 14px;\\n        line-height: 22px;\\n      }\\n\\n      .rc-virtual-list-holder-inner {\\n        gap: 4px;\\n\\n        .ant-select-item {\\n          border-radius: 6px;\\n        }\\n\\n        .ant-select-item-option-selected:not(.ant-select-item-option-disabled),\\n        .ant-select-item-option-active:not(.ant-select-item-option-disabled) {\\n          background-color: #D2EBFF;\\n        }\\n\\n        .ant-select-item-option-active:not(.ant-select-item-option-disabled) {\\n          background-color: #EAECF0;\\n        }\\n      }\\n\\n      &-item {\\n        display: flex;\\n        flex-direction: column;\\n        gap: 8px;\\n      }\\n\\n      .ant-select-single .ant-select-selector {\\n        border-radius: 8px;\\n\\n        .option-title {\\n          width: 281px;\\n          overflow: hidden;\\n          white-space: nowrap;\\n          text-overflow: ellipsis;\\n        }\\n      }\\n\\n      .ant-select-item-option-content,\\n      .ant-select-single.ant-select-show-arrow .ant-select-selection-item {\\n        display: flex;\\n        align-items: center;\\n        gap: 8px;\\n      }\\n\\n      .ant-select-item-option-content {\\n        svg {\\n          display: none;\\n        }\\n      }\\n\\n      .select-source-setting {\\n        width: 100%;\\n\\n        &-option {\\n          .option-title {\\n            color: #1D2939;\\n            font-size: 14px;\\n            font-style: normal;\\n            font-weight: 500;\\n            line-height: 22px;\\n          }\\n        }\\n      }\\n    }\\n  }\\n}\\n\\n@keyframes sip-call-spinner {\\n\tto {\\n\t\ttransform: rotate(360deg);\\n\t}\\n}\\n\\n@-webkit-keyframes sip-call-spinner {\\n\tto {\\n\t\t-webkit-transform: rotate(360deg);\\n\t}\\n}\\n\\n.no-data-placeholder {\\n  padding-top: 10px;\\n  text-align: center;\\n  color: #777;\\n\\n  .sip-call-spinner {\\n    min-width: 30px;\\n    min-height: 30px;\\n  }\\n  \\n  .sip-call-spinner:before {\\n    position: absolute;\\n    top: 50%;\\n    left: 50%;\\n    width: 24px;\\n    height: 24px;\\n    margin-top: -15px;\\n    margin-left: -13px;\\n  }\\n  \\n  .sip-call-spinner:not(:required):before {\\n    content: \\\"\\\";\\n    border-radius: 50%;\\n    border: 1px solid #ccc;\\n    border-top-color: #364c7d;\\n    animation: sip-call-spinner 0.6s linear infinite;\\n  }\\n  \\n  .spinner.slow-3s:before {\\n    animation: sip-call-spinner 3s linear infinite;\\n  }\\n}\\n\\n.call-log-loading {\\n  height: 76px;\\n  margin: 0 20px;\\n  padding: 12px;\\n  width: initial;\\n  display: flex;\\n  align-items: center;\\n\\n  .ant-skeleton-header {\\n    padding-inline-end: 12px;\\n\\n    .ant-skeleton-avatar {\\n      width: 45px;\\n      height: 45px;\\n    }\\n  }\\n\\n  .ant-skeleton-content {\\n    .ant-skeleton-paragraph {\\n      margin: 0;\\n\\n      li {\\n        height: 12px;\\n        margin-block-start: 8px;\\n        border-radius: 20px;\\n      }\\n    }\\n  }\\n}\\n\\n.call-log-filter-popover {\\n  .ant-modal .ant-modal-content {\\n    padding: 16px 24px 26px;\\n    border-radius: 16px ;\\n    background: white;\\n\\n    .ant-modal-close {\\n      border-radius: 8px;\\n      inset-inline-end: 18px;\\n  \\n      &:hover {\\n        background-color: #dde1e7;\\n      }\\n    }\\n\\n    .ant-modal-header {\\n      padding: 0px;\\n      margin-bottom: 16px;\\n      border: none;\\n      color: #1D2939;\\n    }\\n\\n    .ant-modal-body {\\n      padding: 12px 0px;\\n\\n      .select-user-search {\\n        height: 34px;\\n        width: 100%;\\n        margin: 8px 0 16px;\\n\\n        .ant-select-selector {\\n          padding: 5px 12px;\\n        }\\n\\n        .ant-select-arrow {\\n          font-size: 16px;\\n          color: #667085;\\n        }\\n\\n        .select-user-dropdown {\\n          padding: 6px;\\n\\n          .rc-virtual-list-holder-inner {\\n            gap: 4px;\\n\\n            .ant-select-item {\\n              padding: 6px 12px;\\n              border-radius: 6px;\\n            }\\n            \\n            .ant-select-item-option-selected:not(.ant-select-item-option-disabled) {\\n              background-color: #D2EBFF;\\n\\n              div {\\n                font-weight: 500;\\n              }\\n            }\\n\\n            .ant-select-item-option-active:not(.ant-select-item-option-disabled) {\\n              background-color: #DDE1E7;\\n            }\\n          }\\n        }\\n\\n        .ant-select-clear {\\n          width: 18px;\\n          height: 22px;\\n          margin-top: -10px;\\n          font-size: 20px;\\n          color: #98A2B3;\\n        }\\n\\n        .user-avatar {\\n          margin-right: 8px;\\n        }\\n      }\\n\\n\\n      #call-log-filter-content {\\n        position: relative;\\n        height: 347px;\\n\\n        .ant-picker {\\n\t\t\t\t\twidth: 100%;\\n\t\t\t\t\tpadding: 0px;\\n\t\t\t\t\tgap: 10px;\\n\t\t\t\t\tborder: none;\\n\t\t\t\t\tbox-shadow: none;\\n\\n\t\t\t\t\t.ant-picker-input {\\n\t\t\t\t\t\tpadding: 5px 12px 5px 40px;\\n\t\t\t\t\t\tborder-radius: 8px;\\n\t\t\t\t\t\tborder: 1px solid #D0D5DD;\\n\\n\t\t\t\t\t\t&:hover {\\n\t\t\t\t\t\t\tborder: 1px solid #1677FF;\\n\t\t\t\t\t\t}\\n\t\t\t\t\t}\\n\\n\t\t\t\t\t.ant-picker-range-separator, .ant-picker-active-bar {\\n\t\t\t\t\t\tdisplay: none;\\n\t\t\t\t\t}\\n\\n\t\t\t\t\t.ant-picker-suffix {\\n\t\t\t\t\t\tposition: absolute;\\n\t\t\t\t\t\tmargin-inline-start: 12px;\\n\\n\t\t\t\t\t\t&>*:not(:last-child) {\\n\t\t\t\t\t\t\tmargin-inline-end: 210px\\n\t\t\t\t\t\t}\\n\t\t\t\t\t}\\n\t\t\t\t}\\n\\n\t\t\t\t.ant-picker-focused {\\n\t\t\t\t\t.ant-picker-input-active {\\n\t\t\t\t\t\tborder: 1px solid #1677FF;\\n\t\t\t\t\t\tbox-shadow: 0px 1px 2px 0px rgba(99, 153, 242, 0.20), 0px 0px 0px 4px rgba(99, 153, 242, 0.20);\\n\t\t\t\t\t}\\n\t\t\t\t}\\n\\n        .ant-picker-dropdown {\\n          position: absolute;\\n          top: 72px !important;\\n          padding: 0px;\\n          z-index: auto !important;\\n          user-select: none;\\n\\n          .ant-picker-range-wrapper {\\n            height: 277px;\\n          }\\n        }\\n        \\n        .ant-picker-range-arrow {\\n          display: none;\\n        }\\n\\n        .ant-picker-panel-container {\\n          box-shadow: none;\\n        }\\n\\n        .ant-picker-panel {\\n          .ant-picker-header {\\n            height: 41px;\\n            padding: 0px 0px 8px;\\n            align-items: center;\\n            border-bottom: 1px solid #F2F4F7;\\n\\n            .ant-picker-header-view {\\n              line-height